NEXT_PUBLIC_SITE_URL=https://socialsanvad.com
NEXT_PUBLIC_WHATSAPP_NUMBER=917738533840

# Cashfree Payment Gateway
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Local webhook testing only — never true in production
# CASHFREE_SKIP_WEBHOOK_VERIFY=true

# Secure ebook delivery (required on Vercel production)
# Free Upstash Redis: https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PDF source (pick one)
# A) Private file on server (local / included in deploy)
EBOOK_PDF_PATH=private/ebooks/karykartyachi-ai-diary.pdf
EBOOK_PDF_FILENAME=karykartyachi-ai-diary.pdf
# B) Or private remote URL (fetched server-side, never exposed to buyer)
# EBOOK_PDF_URL=https://...

# MSG91 WhatsApp auto-send (after template is Approved)
MSG91_AUTH_KEY=
MSG91_INTEGRATED_NUMBER=91XXXXXXXXXX
MSG91_TEMPLATE_NAME=
MSG91_TEMPLATE_LANGUAGE=mr
# MSG91_TEMPLATE_NAMESPACE=
# Variable mapping: name | downloadUrl | orderId
# MSG91_VAR_1=name
# MSG91_VAR_2=downloadUrl
# MSG91_VAR_3=orderId

# Blog article update template (Marketing — bloglinksupdate)
MSG91_BLOG_TEMPLATE_NAME=bloglinksupdate
MSG91_BLOG_TEMPLATE_LANGUAGE=mr
MSG91_BLOG_TEMPLATE_NAMESPACE=3c119cfc_8dca_4e60_b53d_28e9458ff7c2

# Admin orders page (/admin/orders)
ADMIN_PASSWORD=
# Optional; defaults to ADMIN_PASSWORD
# ADMIN_SESSION_SECRET=

# Google Tag Manager (loads GA4 via GTM dashboard — do not also add direct gtag)
NEXT_PUBLIC_GTM_ID=GTM-P7JMWJPT

# Meta (Facebook) Pixel — kept in site code (not via GTM)
NEXT_PUBLIC_META_PIXEL_ID=3625309240965799

# Karyakarta AI Tool
# Google OAuth (Consent screen + Web client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional dedicated session secret (falls back to ADMIN_SESSION_SECRET)
# KARYAKARTA_SESSION_SECRET=
# Dev only: allow prompt generation without subscription
# KARYAKARTA_ALLOW_PREVIEW=true
# MSG91 WhatsApp OTP template (optional; otherwise OTP shown in API response in non-prod)
# MSG91_OTP_TEMPLATE_NAME=
# Client Cashfree mode hint for checkout.js
# NEXT_PUBLIC_CASHFREE_ENV=sandbox
